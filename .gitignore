# =============================================================
# ROOT .gitignore — Durga Puja Hoping (Monorepo)
# Covers: frontend (Next.js), backend (Node.js), OS, editors
# =============================================================

# ─── Dependencies ────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js (frontend) ──────────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/

# ─── Backend build ───────────────────────────────────────────
backend/dist/
backend/build/

# ─── Testing & Coverage ──────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ─── Environment & Secrets ───────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Runtime & Process ───────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock

# ─── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Certificates & Keys ─────────────────────────────────────
*.pem
*.key
*.crt
*.p12

# ─── Deployment ──────────────────────────────────────────────
.vercel
.netlify

# ─── Package manager caches ──────────────────────────────────
.npm/
.pnpm-store/
.cache/
.parcel-cache/

# ─── Operating System ────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ─── Editors & IDEs ──────────────────────────────────────────
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*.swn
[._]*.s[a-v][a-z]
[._]*.sw[a-p]

# Sublime Text
*.sublime-workspace

# ─── Misc ────────────────────────────────────────────────────
*.tgz
*.tar.gz
*.zip
.agents/